  "info": {
    "title": "CampusLoop API",
    "description": "Campus resource sharing, borrowing and handover API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72
          },
          "campus": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "campus"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ]
      },
      "CreateResourceDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "itemCondition": {
            "type": "string",
            "enum": [
              "new",
              "good",
              "fair",
              "worn"
            ]
          },
          "borrowingRules": {
            "type": "string",
            "maxLength": 1000
          },
          "maxLoanDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "pickupLocation": {
            "type": "string",
            "maxLength": 150
          }
        },
        "required": [
          "title",
          "categoryId"
        ]
      },
      "UpdateResourceDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "itemCondition": {
            "type": "string",
            "enum": [
              "new",
              "good",
              "fair",
              "worn"
            ]
          },
          "borrowingRules": {
            "type": "string",
            "maxLength": 1000
          },
          "maxLoanDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "pickupLocation": {
            "type": "string",
            "maxLength": 150
          },
          "isListed": {
            "type": "boolean"
          }
        }
      },
      "ResourceCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "createdAt"
        ]
      },
      "CreateBorrowRequestDto": {
        "type": "object",
        "properties": {
          "resourceId": {
            "type": "string",
            "format": "uuid"
          },
          "dueDate": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "resourceId",
          "dueDate"
        ]
      },
      "BorrowRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "borrowerId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "active",
              "returned",
              "rejected",
              "cancelled",
              "expired"
            ],
            "type": "string"
          },
          "dueDate": {
            "format": "date-time",
            "type": "string"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "resourceId",
          "borrowerId",
          "status",
          "dueDate",
          "message",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}