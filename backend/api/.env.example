# Copy to .env and fill in. Placeholder values only — never commit real secrets.

# --- Server ---
NODE_ENV=development
PORT=3001
# Frontend origin allowed by CORS and used in email links.
WEB_URL=http://localhost:3000
# Only set when behind a proxy you control: "1", "loopback", "10.0.0.0/8". Leave empty to ignore X-Forwarded-For.
TRUST_PROXY=

# --- Database (MySQL 8, server clock must be UTC) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=campusloop
DB_PASSWORD=change-me
DB_DATABASE=campusloop
# npm run admin:promote -- user@example.com ignores this value: it only runs when DB_DATABASE is set
# for that command, e.g. PowerShell: $env:DB_DATABASE='campusloop'; npm run admin:promote -- user@example.com

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Mail (SMTP_HOST is required when NODE_ENV=production) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusLoop <no-reply@example.com>

# --- Redis / BullMQ ---
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=
# Set to false to run without Redis: in-app notifications still work, emails and reminders do not.
NOTIFICATIONS_QUEUE_ENABLED=true

# --- Borrowing ---
# Hours an approved request may wait for pickup before it expires (code default: 48).
BORROW_PICKUP_WINDOW_HOURS=48
BORROW_EXPIRY_SWEEP_ENABLED=true

# --- Uploads ---
# One folder per kind of image; they must differ (the API refuses to boot otherwise).
# Resource photos are served publicly; lost-and-found photos are access-controlled.
UPLOAD_DIR=./uploads/resources
LOST_FOUND_UPLOAD_DIR=./uploads/lost-found

# --- E2E tests only (see test/guard-test-db.ts; DB name must end in _test) ---
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3317
TEST_DB_USER=root
TEST_DB_PASSWORD=root
TEST_DB_NAME=campusloop_test
TEST_REDIS_URL=redis://127.0.0.1:6390
