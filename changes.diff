+  Controller,
+  Get,
+  Param,
+  ParseUUIDPipe,
+  Patch,
+  Query,
+  Req,
+} from '@nestjs/common';
+import type { Request } from 'express';
+import { Roles } from '../auth/roles.decorator.js';
