# Copy to .env.local and fill in. Placeholder values only.

# NestJS API base URL, used server-side (route handlers, proxy, server components).
API_URL=http://localhost:3001/api
# Same API, exposed to the browser for building image URLs only. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Number of trusted reverse-proxy hops in front of Next.js, used to read the client IP (0 = none).
TRUSTED_PROXY_HOPS=0
